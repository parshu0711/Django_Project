# Copy this file to .env and adjust the values.

# Required when DJANGO_DEBUG=False (the app refuses to start with the placeholder). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) allowed to POST forms when behind HTTPS, e.g. https://polarops.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=
# Shown in the footer; all dates and times are displayed in this zone.
TIME_ZONE=Asia/Kolkata
# One-click switching between demo accounts. Defaults to DJANGO_DEBUG.
# Must be False in production: the app reports an error (polarops.E001) if it is on while DEBUG is off.
DEMO_MODE=True

# ---- Database ----
# sqlite (default, zero setup) or postgres (recommended for production)
DB_ENGINE=sqlite
# Used only when DB_ENGINE=postgres
DB_NAME=polarops
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---- Email alerts (HIGH / CRITICAL incidents are emailed to HQ) ----
# Console backend prints emails in the server terminal. Use smtp in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PolarOps Alerts <alerts@polarops.local>
# Seconds to wait for the mail server before giving up (keeps a dead satellite link from hanging requests)
EMAIL_TIMEOUT=10

# ---- Maps ----
# Google Maps JavaScript API key. Leave empty to use OpenStreetMap / Leaflet (no key needed).
# Restrict the key to your site's HTTP referrers in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# ---- Automatic alert thresholds ----
ALERT_WIND_KMH=100
ALERT_TEMP_C=-45
ALERT_VISIBILITY_KM=0.2
ALERT_FUEL_PCT=20
ALERT_BATTERY_PCT=15

# ---- HTTPS (only used when DJANGO_DEBUG=False) ----
SECURE_SSL_REDIRECT=True
# Set to 31536000 (one year) once HTTPS is confirmed working
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# True when nginx / a load balancer terminates TLS and sets X-Forwarded-Proto
BEHIND_HTTPS_PROXY=False

# ---- API rate limits ----
API_RATE_USER=600/min
API_RATE_TOKEN=10/min

# ---- Logging ----
LOG_LEVEL=INFO
# Optional log file in addition to the console, e.g. logs/polarops.log
LOG_FILE=
